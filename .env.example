# === Required ===
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
MM_SLASH_TOKEN=your-mattermost-slash-command-token

# === Single Project (Legacy Mode) ===
# Use these for a single GitLab project:
GITLAB_PROJECT_ID=guidedgrowth-group%2Fguided-growth-mvp
GITLAB_URL=https://gitlab.com
PROJECT_LABELS=ai,bug,documentation,enhancement,infrastructure,prototype,research,voice,priorityhigh,prioritymedium,prioritylow,good first issue,help wanted

# === Multi-Project Mode ===
# Set GITLAB_PROJECTS as JSON instead of GITLAB_PROJECT_ID:
# GITLAB_PROJECTS={"frontend":{"id":"123","name":"Frontend","labels":"bug,feature"},"backend":{"id":"456","name":"Backend API","labels":"bug,infra"}}
# GITLAB_DEFAULT_PROJECT=frontend

# === LLM Provider ===
# Options: openai | anthropic | ollama | gemini
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Leave blank to use provider default model
LLM_MODEL=
# Override base URL (required for ollama, optional otherwise)
LLM_BASE_URL=

# === Optional ===
BOT_URL=http://localhost:8321
MM_SITE_URL=http://localhost:8065

# === Storage (Phase 2) ===
# SQLite database path (default: data/issuebot.db)
# BOT_DB_PATH=data/issuebot.db

# === Webhooks (Phase 2) ===
# GITLAB_WEBHOOK_SECRET=your-webhook-secret
# MM_BOT_TOKEN=your-mattermost-bot-token
# MM_NOTIFY_CHANNEL_ID=channel-id-for-notifications

# === GitHub (Phase 3) ===
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_URL=https://api.github.com
